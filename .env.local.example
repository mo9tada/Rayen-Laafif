
# --- Admin dashboard (/adminray) -------------------------------------------
# Generate both values with:  npm run set-admin-password "your password"
# Never commit the real values. Rotating the session secret logs everyone out.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Where descriptions are stored. Defaults to ./data/videos.json.
# Serverless hosts (Vercel) have a read-only filesystem - see src/lib/store.js.
ADMIN_DATA_FILE=
